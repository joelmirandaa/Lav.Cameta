<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espaco_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Lav.Texto.H3" />

        <TextView
            android:id="@+id/descricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Lav.Texto.Auxiliar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoPreco"
                style="@style/Lav.CampoLayout"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="@string/campo_preco">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/preco"
                    style="@style/Lav.CampoTexto"
                    android:inputType="numberDecimal"
                    android:maxLength="9" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoDuracao"
                style="@style/Lav.CampoLayout"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/espaco_2"
                android:layout_weight="1"
                android:hint="@string/campo_duracao">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/duracao"
                    style="@style/Lav.CampoTexto"
                    android:inputType="number"
                    android:maxLength="3" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/salvar"
            style="@style/Lav.Botao.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_2"
            android:text="@string/acao_salvar" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
