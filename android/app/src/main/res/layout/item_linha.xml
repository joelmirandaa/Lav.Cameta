<?xml version="1.0" encoding="utf-8"?>
<!-- Linha genérica: ícone, título, subtítulo, valor/selo e ação opcional. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingTop="@dimen/espaco_1"
    android:paddingBottom="@dimen/espaco_1">

    <ImageView
        android:id="@+id/icone"
        android:layout_width="@dimen/icone"
        android:layout_height="@dimen/icone"
        android:importantForAccessibility="no"
        app:tint="@color/marinho" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_2"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Lav.Texto.Enfase" />

        <TextView
            android:id="@+id/subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Lav.Texto.Auxiliar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/valor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Lav.Texto.Enfase" />

        <TextView
            android:id="@+id/selo"
            style="@style/Lav.Selo"
            android:layout_marginTop="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/acao"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="@dimen/altura_controle"
        android:layout_height="@dimen/altura_controle"
        android:visibility="gone"
        app:iconTint="@color/erro" />
</LinearLayout>
