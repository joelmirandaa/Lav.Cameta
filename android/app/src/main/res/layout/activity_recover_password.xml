<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include android:id="@+id/barra" layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <br.com.lavicameta.ui.component.MaxWidthLinearLayout style="@style/Lav.Formulario">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/recuperar_titulo"
                android:textAppearance="@style/Lav.Texto.H1" />

            <!-- Etapa 1: solicitar código -->
            <LinearLayout
                android:id="@+id/etapaSolicitar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_1"
                    android:text="@string/recuperar_instrucao"
                    android:textAppearance="@style/Lav.Texto.Auxiliar" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoEmail"
                    style="@style/Lav.CampoLayout"
                    android:hint="@string/campo_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        style="@style/Lav.CampoTexto"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionDone"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/enviarCodigo"
                    style="@style/Lav.BotaoPrincipal"
                    android:text="@string/acao_enviar_codigo" />
            </LinearLayout>

            <!-- Etapa 2: redefinir com o código -->
            <LinearLayout
                android:id="@+id/etapaRedefinir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/codigoEnviado"
                    style="@style/Lav.Alerta.Sucesso"
                    android:visibility="visible" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoCodigo"
                    style="@style/Lav.CampoLayout"
                    android:hint="@string/campo_codigo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/codigo"
                        style="@style/Lav.CampoTexto"
                        android:autofillHints="smsOTPCode"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:maxLength="12" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoSenha"
                    style="@style/Lav.CampoLayout"
                    android:hint="@string/campo_nova_senha"
                    app:endIconMode="password_toggle"
                    app:helperText="@string/ajuda_senha">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/senha"
                        style="@style/Lav.CampoTexto"
                        android:autofillHints="newPassword"
                        android:inputType="textPassword"
                        android:maxLength="72" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoConfirmacao"
                    style="@style/Lav.CampoLayout"
                    android:hint="@string/campo_confirmar_senha"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/confirmacao"
                        style="@style/Lav.CampoTexto"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLength="72" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/redefinir"
                    style="@style/Lav.BotaoPrincipal"
                    android:text="@string/acao_redefinir" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reenviar"
                    style="@style/Lav.Botao.Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/acao_reenviar" />
            </LinearLayout>

            <!-- Etapa 3: concluído -->
            <LinearLayout
                android:id="@+id/etapaConcluido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Lav.Alerta.Sucesso"
                    android:text="@string/recuperar_concluido"
                    android:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/irLogin"
                    style="@style/Lav.BotaoPrincipal"
                    android:text="@string/acao_ir_login" />
            </LinearLayout>

            <TextView
                android:id="@+id/erro"
                style="@style/Lav.Alerta.Erro" />
        </br.com.lavicameta.ui.component.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>
