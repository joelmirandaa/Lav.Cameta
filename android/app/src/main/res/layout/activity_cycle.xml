<?xml version="1.0" encoding="utf-8"?>
<!-- Acompanhamento do ciclo (tela prevista, não prototipada; segue o guia de design). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include android:id="@+id/barra" layout="@layout/toolbar" />

    <include layout="@layout/view_estado" />

    <ScrollView
        android:id="@+id/rolagem"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <br.com.lavicameta.ui.component.MaxWidthLinearLayout
            style="@style/Lav.Formulario"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/icone"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="@dimen/espaco_3"
                android:background="@drawable/bg_icone_maquina"
                android:importantForAccessibility="no"
                android:padding="24dp"
                android:src="@drawable/ic_washing_machine"
                app:tint="@color/roxo" />

            <TextView
                android:id="@+id/titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_3"
                android:accessibilityHeading="true"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textAppearance="@style/Lav.Texto.H2" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_3">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progresso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:indicatorColor="@color/lilas"
                    app:indicatorSize="@dimen/anel_ciclo"
                    app:trackColor="@color/borda"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="@dimen/anel_ciclo_espessura" />

                <LinearLayout
                    android:id="@+id/painelTempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/minutos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Lav.Texto.Valor"
                        android:textColor="@color/roxo"
                        android:textSize="@dimen/texto_tempo"
                        android:lineHeight="@dimen/linha_tempo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ciclo_restantes"
                        android:textAppearance="@style/Lav.Texto.Auxiliar" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_2"
                android:gravity="center"
                android:textAppearance="@style/Lav.Texto" />

            <TextView
                android:id="@+id/maquina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_1"
                android:gravity="center"
                android:textAppearance="@style/Lav.Texto.Auxiliar" />

            <TextView
                android:id="@+id/aviso"
                style="@style/Lav.Alerta.Aviso" />

            <TextView
                android:id="@+id/erro"
                style="@style/Lav.Alerta.Erro" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/iniciarSecagem"
                style="@style/Lav.BotaoPrincipal"
                android:text="@string/acao_iniciar_secagem"
                android:visibility="gone"
                app:icon="@drawable/ic_wind"
                app:iconTint="@color/branco" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/voltarInicio"
                style="@style/Lav.Botao.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_2"
                android:text="@string/acao_voltar_inicio" />
        </br.com.lavicameta.ui.component.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>
