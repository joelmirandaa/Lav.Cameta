<?xml version="1.0" encoding="utf-8"?>
<!-- T02 Escolha uma máquina -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/altura_cabecalho"
        android:background="@color/branco"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margem_tela"
        android:paddingEnd="@dimen/margem_tela">

        <ImageView
            android:layout_width="@dimen/largura_logo_cabecalho"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/logo_descricao"
            android:src="@drawable/logo_nome" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/saudacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="160dp"
            android:textAppearance="@style/Lav.Texto.Auxiliar" />
    </LinearLayout>

    <View style="@style/Lav.Divisor" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_3"
        android:accessibilityHeading="true"
        android:paddingStart="@dimen/margem_tela"
        android:paddingEnd="@dimen/margem_tela"
        android:text="@string/maquinas_titulo"
        android:textAppearance="@style/Lav.Texto.H2" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/filtros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_2"
        android:paddingStart="@dimen/margem_tela"
        android:paddingEnd="@dimen/margem_tela"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/filtroLavar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/filtro_lavar" />

        <com.google.android.material.chip.Chip
            android:id="@+id/filtroSecar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/filtro_secar" />

        <com.google.android.material.chip.Chip
            android:id="@+id/filtroAmbos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:checked="true"
            android:text="@string/filtro_ambos" />
    </com.google.android.material.chip.ChipGroup>

    <include layout="@layout/view_estado" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/atualizar"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/margem_tela"
            android:paddingTop="@dimen/espaco_1"
            android:paddingEnd="@dimen/margem_tela"
            android:paddingBottom="@dimen/espaco_3" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
