<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espaco_1"
    android:layout_marginBottom="@dimen/espaco_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icone_maquina"
                android:importantForAccessibility="no"
                android:padding="12dp"
                app:tint="@color/marinho" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_2"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Lav.Texto.Enfase" />

                <TextView
                    android:id="@+id/descricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Lav.Texto.Auxiliar" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                style="@style/Lav.Selo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_2"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editar"
                style="@style/Lav.Botao.Secundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/acao_editar"
                app:icon="@drawable/ic_pencil" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manutencao"
                style="@style/Lav.Botao.Secundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_1"
                android:layout_weight="1"
                app:icon="@drawable/ic_wrench" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
