<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include android:id="@+id/barra" layout="@layout/toolbar" />

        <include layout="@layout/view_estado" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/atualizar"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/margem_tela"
                android:paddingTop="@dimen/espaco_1"
                android:paddingEnd="@dimen/margem_tela"
                android:paddingBottom="96dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/nova"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/margem_tela"
        android:text="@string/acao_nova_maquina"
        android:textColor="@color/branco"
        app:backgroundTint="@color/roxo"
        app:icon="@drawable/ic_plus"
        app:iconTint="@color/branco" />
</FrameLayout>
