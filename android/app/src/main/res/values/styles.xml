<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos de componentes reutilizados entre telas (evita valores visuais espalhados). -->
<resources>
    <style name="Lav.Formulario" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/margem_tela</item>
        <item name="android:paddingEnd">@dimen/margem_tela</item>
        <item name="android:paddingTop">@dimen/espaco_3</item>
        <item name="android:paddingBottom">@dimen/espaco_4</item>
        <item name="larguraMaxima">@dimen/largura_maxima_conteudo</item>
    </style>

    <style name="Lav.CampoLayout" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/espaco_2</item>
    </style>

    <style name="Lav.CampoTexto" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/altura_controle</item>
        <item name="android:textSize">@dimen/texto_corpo</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:fontFamily">@font/outfit</item>
    </style>

    <style name="Lav.BotaoPrincipal" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/espaco_3</item>
    </style>

    <style name="Lav.Selo" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_selo</item>
        <item name="android:paddingStart">@dimen/espaco_1</item>
        <item name="android:paddingEnd">@dimen/espaco_1</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">@dimen/texto_auxiliar</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:fontFamily">@font/outfit</item>
    </style>

    <style name="Lav.Alerta" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/espaco_2</item>
        <item name="android:padding">@dimen/espaco_2</item>
        <item name="android:drawablePadding">@dimen/espaco_1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">@dimen/texto_auxiliar</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Lav.Alerta.Erro">
        <item name="android:background">@drawable/bg_estado_erro</item>
        <item name="android:textColor">@color/erro</item>
        <item name="android:drawableStart">@drawable/ic_circle_alert</item>
        <item name="android:drawableTint">@color/erro</item>
        <item name="android:accessibilityLiveRegion">assertive</item>
    </style>

    <style name="Lav.Alerta.Sucesso">
        <item name="android:background">@drawable/bg_estado_sucesso</item>
        <item name="android:textColor">@color/sucesso</item>
        <item name="android:drawableStart">@drawable/ic_circle_check</item>
        <item name="android:drawableTint">@color/sucesso</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>

    <style name="Lav.Alerta.Info">
        <item name="android:background">@drawable/bg_estado_info</item>
        <item name="android:textColor">@color/info</item>
        <item name="android:drawableStart">@drawable/ic_clock</item>
        <item name="android:drawableTint">@color/info</item>
        <item name="android:visibility">visible</item>
    </style>

    <style name="Lav.Alerta.Aviso">
        <item name="android:background">@drawable/bg_estado_alerta</item>
        <item name="android:textColor">@color/alerta</item>
        <item name="android:drawableStart">@drawable/ic_circle_alert</item>
        <item name="android:drawableTint">@color/alerta</item>
    </style>

    <!-- Botão secundário em pares lado a lado (cartões em 2 colunas no tablet): ícone 20dp e padding menor, sem quebrar o rótulo. -->
    <style name="Lav.Botao.Secundario.Compacto">
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Lav.Divisor" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/borda</item>
    </style>

    <style name="Lav.Secao" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/espaco_3</item>
        <item name="android:layout_marginBottom">@dimen/espaco_1</item>
        <item name="android:textAppearance">@style/Lav.Texto.H3</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
</resources>
