<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Lavicameta" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/agua</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorPrimaryContainer">@color/info_fundo</item>
        <item name="colorOnPrimaryContainer">@color/marinho</item>
        <item name="colorSecondary">@color/marinho</item>
        <item name="colorOnSecondary">@color/branco</item>
        <item name="colorSecondaryContainer">@color/info_fundo</item>
        <item name="colorOnSecondaryContainer">@color/marinho</item>
        <item name="colorError">@color/erro</item>
        <item name="android:colorBackground">@color/branco</item>
        <item name="colorSurface">@color/branco</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorOnSurfaceVariant">@color/texto_secundario</item>
        <item name="colorOutline">@color/borda</item>
        <item name="colorOutlineVariant">@color/borda</item>
        <item name="colorSurfaceContainer">@color/branco</item>
        <item name="colorSurfaceContainerLow">@color/branco</item>
        <item name="colorSurfaceContainerHigh">@color/branco</item>
        <item name="colorControlNormal">@color/texto</item>
        <!-- Superfícies brancas: sem tingimento azulado de elevação do Material 3. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurfaceContainerLowest">@color/branco</item>
        <item name="colorSurfaceContainerHighest">@color/branco</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
        <item name="android:statusBarColor">@color/branco</item>
        <item name="android:navigationBarColor">@color/branco</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/branco</item>
        <item name="materialButtonStyle">@style/Lav.Botao</item>
        <item name="materialButtonOutlinedStyle">@style/Lav.Botao.Secundario</item>
        <item name="textInputStyle">@style/Lav.Campo</item>
        <item name="materialCardViewStyle">@style/Lav.Cartao</item>
        <item name="toolbarStyle">@style/Lav.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Lav.BottomNav</item>
        <item name="tabStyle">@style/Lav.Abas</item>
        <item name="chipStyle">@style/Lav.Filtro</item>
        <item name="circularProgressIndicatorStyle">@style/Lav.Carregando</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Lav.Dialogo</item>
        <item name="shapeAppearanceCornerSmall">@style/Lav.Forma.Raio</item>
        <item name="shapeAppearanceCornerMedium">@style/Lav.Forma.Raio</item>
        <item name="shapeAppearanceCornerLarge">@style/Lav.Forma.RaioGrande</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/Lav.Forma.RaioGrande</item>
    </style>

    <style name="Lav.Forma.Raio" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/raio</item>
    </style>

    <style name="Lav.Forma.RaioGrande" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/raio_grande</item>
    </style>

    <!-- Tipografia (guia, seção 4): títulos 700, texto 400, ênfase 600. -->
    <style name="Lav.Texto" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">@dimen/texto_corpo</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Lav.Texto.H1">
        <item name="android:textSize">@dimen/texto_h1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <style name="Lav.Texto.H2">
        <item name="android:textSize">@dimen/texto_h2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <style name="Lav.Texto.H3">
        <item name="android:textSize">@dimen/texto_h3</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <style name="Lav.Texto.Enfase">
        <item name="android:textFontWeight">600</item>
    </style>

    <style name="Lav.Texto.Auxiliar">
        <item name="android:textSize">@dimen/texto_auxiliar</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="Lav.Texto.Rotulo">
        <item name="android:textSize">@dimen/texto_minimo</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <style name="Lav.Texto.Valor">
        <item name="android:textSize">@dimen/texto_h1</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Botões (guia, seção 5): 48dp, raio 12, primário azul-água, secundário contornado marinho. -->
    <style name="Lav.Botao" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/altura_controle</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/raio</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/texto_corpo</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/selector_botao_primario</item>
        <item name="android:textColor">@color/selector_texto_botao_primario</item>
    </style>

    <style name="Lav.Botao.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/altura_controle</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/raio</item>
        <item name="strokeColor">@color/marinho</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/marinho</item>
        <item name="iconTint">@color/marinho</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/texto_corpo</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Lav.Botao.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/altura_controle</item>
        <item name="android:textColor">@color/agua</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Campos (guia, seção 5): rótulo visível, borda 1dp #D6E3F0, foco azul-água, raio 12. -->
    <style name="Lav.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/raio</item>
        <item name="boxCornerRadiusTopEnd">@dimen/raio</item>
        <item name="boxCornerRadiusBottomStart">@dimen/raio</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/raio</item>
        <item name="boxStrokeColor">@color/selector_borda_campo</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeErrorColor">@color/erro</item>
        <item name="errorTextColor">@color/erro</item>
        <item name="errorIconDrawable">@drawable/ic_circle_alert</item>
        <item name="errorIconTint">@color/erro</item>
        <item name="hintTextColor">@color/agua</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="endIconTint">@color/texto_secundario</item>
        <item name="hintTextAppearance">@style/Lav.Texto.Auxiliar</item>
    </style>

    <style name="Lav.Cartao" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/branco</item>
        <item name="strokeColor">@color/borda</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/raio_grande</item>
        <item name="cardElevation">1dp</item>
        <item name="contentPadding">@dimen/padding_card</item>
    </style>

    <style name="Lav.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/branco</item>
        <item name="titleTextAppearance">@style/Lav.Texto.H3</item>
        <item name="navigationIconTint">@color/marinho</item>
    </style>

    <style name="Lav.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/branco</item>
        <item name="itemIconTint">@color/selector_nav</item>
        <item name="itemTextColor">@color/selector_nav</item>
        <item name="itemActiveIndicatorStyle">@style/Lav.BottomNav.Indicador</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Lav.BottomNav.Indicador" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/info_fundo</item>
    </style>

    <!-- Abas (guia): aba ativa com sublinhado 3dp azul-água. -->
    <style name="Lav.Abas" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/agua</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabSelectedTextColor">@color/agua</item>
        <item name="tabTextColor">@color/marinho</item>
        <item name="tabTextAppearance">@style/Lav.Texto.Enfase</item>
        <item name="android:background">@color/branco</item>
    </style>

    <style name="Lav.Filtro" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/selector_filtro_fundo</item>
        <item name="android:textColor">@color/selector_filtro_texto</item>
        <item name="chipStrokeColor">@color/borda</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">@dimen/altura_controle</item>
        <item name="chipCornerRadius">@dimen/raio</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textAppearance">@style/Lav.Texto.Enfase</item>
    </style>

    <style name="Lav.Carregando" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/agua</item>
        <item name="trackColor">@color/info_fundo</item>
    </style>

    <style name="ThemeOverlay.Lav.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/Lav.Forma.RaioGrande</item>
        <item name="colorPrimary">@color/agua</item>
        <item name="android:fontFamily">@font/outfit</item>
    </style>
</resources>
