# Copie para backend/.env (ignorado pelo Git) e ajuste. Nunca versione valores reais.
DB_URL=jdbc:mysql://127.0.0.1:3307/lavicameta
DB_USERNAME=lavicameta
DB_PASSWORD=defina_localmente
# Segredo HMAC dos tokens de acesso: mínimo 32 bytes aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=
JWT_TTL_MINUTES=720
# Primeiro administrador (criado só se não existir nenhum). Senha com 10+ caracteres.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Pagamento: bex (produção; aguarda documentação) | sandbox (homologação local, sem dinheiro real)
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=
# URL pela qual o app alcança a API (usada nos links do checkout sandbox). Emulador: http://10.0.2.2:8080
PUBLIC_BASE_URL=http://10.0.2.2:8080
# Máquinas: hardware (produção; aguarda protocolo) | simulador (homologação)
MACHINE_CONTROLLER=simulador
# Recuperação de senha por e-mail (opcional em desenvolvimento)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Login com Google: Client ID OAuth do tipo "Web" (opcional)
GOOGLE_CLIENT_ID=
